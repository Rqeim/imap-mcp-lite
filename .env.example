# Authentication mode. Only `static` is supported: a single bearer token
# guards /mcp. There is no OIDC, login, or account-management UI.
AUTH_MODE=static

# Bearer token required on /mcp. Send it as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_API_TOKEN=

# Static IMAP account. IMAP_HOST/IMAP_PORT default to Private Email; the
# username is usually the full email address and IMAP_APP_PASSWORD should be
# an app password, not your account password.
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
IMAP_APP_PASSWORD=

# Public URL of this service (no trailing slash).
BASE_URL=https://imap-mcp-lite.example.com

# Central Redis (required; used for one-shot attachment download tickets).
# Point this at your managed/external instance. No Redis is started here.
REDIS_URL=redis://your-central-redis:6379

# Prefix applied to every Redis key this app writes.
REDIS_KEY_PREFIX=imap-mcp-lite:

# Logging
RUST_LOG=info

# Traefik hostname (used in docker-compose labels)
TRAEFIK_HOST=imap-mcp-lite.example.com

# ngrok (used in docker-compose.dev.yml)
NGROK_AUTHTOKEN=your-ngrok-authtoken
# Optional: reserved domain (paid ngrok feature, keeps URL stable)
# NGROK_DOMAIN=your-name.ngrok-free.app
